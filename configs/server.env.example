# Copy this file to configs/server.env and edit values for your cluster.
# The sbatch templates will auto-source configs/server.env if present.

# ------------------------------------------------------------------------------
# Core environment
# ------------------------------------------------------------------------------
export PROJECT_DIR=/mnt/workspace/Medical_Image_Analysis_project

# Option A (recommended): conda env name
export CONDA_ENV=mia
# Option B: full env path (if your cluster does not allow `conda activate`)
# export ENV_PATH=/home/you/.conda/envs/mia

# ------------------------------------------------------------------------------
# Dataset/model paths
# ------------------------------------------------------------------------------
export MODEL_PATH=/mnt/models/Qwen2-VL-2B-Instruct
export DATA_ROOT=/mnt/datasets/nih/data/3
export BBOX_CSV=/mnt/datasets/nih/data/3/BBox_List_2017.csv

# ------------------------------------------------------------------------------
# Common experiment variables (optional but useful for sbatch/train/eval)
# ------------------------------------------------------------------------------
export EMBEDDING_DIR=/mnt/workspace/Medical_Image_Analysis_project/embeddings/emb_alltoken_xxxxx
export MODEL_CKPT=/mnt/workspace/Medical_Image_Analysis_project/output/train/train_residual_ciou_xxxxx/bbox_mlp.pt
export ARCH=residual
export LOSS_NAME=ciou

# Optional output roots
export EMBEDDINGS_ROOT=./embeddings
export OUTPUT_TRAIN_ROOT=./output/train
export OUTPUT_EVAL_ROOT=./output/eval
export OUTPUT_VLM_ROOT=./output/vlm
export OUTPUT_COMPARE_ROOT=./output/compare
